{
  "name": "repurpose-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Private, single-tenant omnichannel content repurposing engine (Next.js + PostgreSQL + Redis/BullMQ + FFmpeg/yt-dlp).",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "worker": "tsx watch src/worker/index.ts",
    "worker:prod": "node dist/worker/index.js",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/worker/index.js --external:@prisma/client --external:.prisma --external:sharp --external:fluent-ffmpeg --external:bullmq --external:ioredis --log-level=info",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "bullmq": "^5.81.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.548.0",
    "next": "16.4.6",
    "prisma": "6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
