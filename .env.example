# ─────────────────────────────────────────────────────────────────────────────
# Repurpose Studio — environment
# OPTIONAL. `docker compose up -d --build` works on a fresh clone: APP_SECRET is
# generated into the `secrets` volume on first boot. Copy this file to .env only
# when you want to override defaults (custom domain, platform credentials, S3…).
# There is NO auth config here on purpose: this is a private single-tenant app.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Public URL of the deployment. Used for OAuth redirect URIs and links.
APP_URL=http://localhost:3000
WEB_PORT=3000
NEXT_PUBLIC_APP_NAME=Repurpose Studio
TZ=UTC

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# docker compose uses the defaults below; on Railway/Render/Neon paste the
# provider's URL instead (keep ?schema=public or ?sslmode=require as required).
POSTGRES_USER=repurpose
POSTGRES_PASSWORD=repurpose
POSTGRES_DB=repurpose
DATABASE_URL=postgresql://repurpose:repurpose@postgres:5432/repurpose?schema=public

# ── Redis / BullMQ ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Secrets ──────────────────────────────────────────────────────────────────
# Leave empty to auto-generate one into the `secrets` volume (recommended).
# To set your own (32+ random chars): openssl rand -hex 32
# Encrypts OAuth access/refresh tokens and secret API keys at rest (AES-256-GCM).
# Changing it invalidates stored tokens — reconnect accounts afterwards.
APP_SECRET=

# Optional bearer token for /api/cron/* endpoints so an external scheduler can
# trigger polls. Not authentication for the app itself; leave empty to disable.
CRON_SECRET=

# ── Media storage ────────────────────────────────────────────────────────────
# local = shared Docker volume (default, zero setup)
# s3    = Cloudflare R2 / AWS S3 / MinIO compatible
STORAGE_DRIVER=local
MEDIA_ROOT=/data/media
# Hours to keep downloaded + processed files after a successful publish.
MEDIA_RETENTION_HOURS=24
# Optional public base for serving local media, e.g. https://media.example.com
MEDIA_BASE_URL=

# S3 / R2 (only needed when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

# ── Media tooling ────────────────────────────────────────────────────────────
# Paths inside the container; the image already ships ffmpeg + yt-dlp.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp
# Optional Netscape-format cookies file for age/region restricted sources.
YTDLP_COOKIES_FILE=

# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
POLL_DEFAULT_INTERVAL_MINUTES=15

# ── Platform developer credentials (optional) ───────────────────────────────
# You can either set them here or paste them into Settings → API credentials
# in the UI (stored in PostgreSQL, encrypted). DB values win over env values.
# Redirect URI pattern for each app: ${APP_URL}/api/oauth/<provider>/callback
# Shown in the UI next to each field.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional provider-specific aliases (used if the generic names are empty):
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional shared Meta app aliases:
META_APP_ID=
META_APP_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
